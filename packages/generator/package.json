{
  "name": "generator",
  "version": "0.1.0",
  "private": true,
  "description": "Retrace CLI: turns trip notes, media and GPS tracks into a static site",
  "type": "module",
  "bin": {
    "retrace": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node src/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.218.0",
    "commander": "15.0.0",
    "env-paths": "4.0.0",
    "exiftool-vendored": "39.0.1",
    "jsonc-parser": "3.3.1",
    "luxon": "3.7.2",
    "sharp": "0.35.5",
    "sirv": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@retrace/shared": "0.1.0",
    "@types/luxon": "3.7.6"
  }
}
